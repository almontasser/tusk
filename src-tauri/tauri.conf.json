{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tusk",
  "version": "0.1.7",
  "identifier": "ly.almontasser.tusk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tusk",
        "width": 1400,
        "height": 900,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "minWidth": 800,
        "minHeight": 500,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mago.toml": "tools/mago.toml",
      "../tusk-lsp/php/introspect.php": "tools/introspect.php"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMzdFRDJEQTNDMjg4RjIKUldUeWlNS2pMZTAzemU2dzdHTmNPMi9pNXhEZ2NZcmdvTDBkbFJQSFprdDFrZjhxTWZkUWs5Z2gK",
      "endpoints": [
        "https://github.com/almontasser/tusk/releases/latest/download/latest.json"
      ]
    }
  }
}
