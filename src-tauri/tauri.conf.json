{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHP Editor",
  "version": "0.1.0",
  "identifier": "dev.almontasser.phpeditor",
  "build": {
    "beforeDevCommand": "sh scripts/fetch-tools.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/fetch-tools.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PHP Editor",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools/": "tools/",
      "resources/mago.toml": "tools/mago.toml"
    }
  }
}