{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tusk",
  "version": "0.1.0",
  "identifier": "ly.almontasser.tusk",
  "build": {
    "beforeDevCommand": "sh scripts/fetch-tools.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/fetch-tools.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tusk",
        "width": 1400,
        "height": 900,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "minWidth": 800,
        "minHeight": 500,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools/": "tools/",
      "resources/mago.toml": "tools/mago.toml",
      "../filament-lsp/": "tools/filament-lsp/"
    }
  }
}